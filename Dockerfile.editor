# Static Markdown slide editor for a separate Google Cloud Run service.
# Build with: docker build -f Dockerfile.editor -t slide-editor .
FROM nginx:alpine

COPY nginx.editor.conf /etc/nginx/conf.d/default.conf

# Editor page only. index.html (the instructor viewer) stays out of this image.
# js/ is copied whole so a new editor module ships without a Dockerfile edit.
COPY editor.html style.css /usr/share/nginx/html/
COPY css/ /usr/share/nginx/html/css/
COPY js/ /usr/share/nginx/html/js/
COPY images/ /usr/share/nginx/html/images/

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
